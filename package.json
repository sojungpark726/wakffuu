{
  "name": "wakppu-simulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "cf:dev": "vite build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "dev:trial": "vite --mode trial --port 5180",
    "build:trial": "tsc --noEmit && vite build --mode trial --base ./ --outDir dist-trial && node scripts/build-trial.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.151.1"
  },
  "engines": {
    "node": ">=22.12"
  }
}
