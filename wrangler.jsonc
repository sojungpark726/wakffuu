{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // 왁뿌 시뮬레이터 배포판: 정적 파일(dist) + /api/* 는 Worker(worker/index.ts)
  "name": "wakffuu",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // wakffuu.<계정>.workers.dev 주소로 연다
  "workers_dev": true,
  // wrangler deploy 가 먼저 화면을 빌드한다 (Windows 에서는 cmd 로 돌아서 sh 명령은 쓰지 않음)
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // 페이지가 하나(/, 공유 링크도 /?ball=)라서 없는 주소는 그냥 404
    "not_found_handling": "none",
    // /api/* 만 Worker 가 받고, 나머지 파일은 Worker 를 거치지 않고 바로 나간다
    "run_worker_first": ["/api/*"]
  },
  // 하루 한정 수량과 공유한 왁뿌볼을 담는 저장소 (따로 만들 필요 없이 배포하면 생김)
  "durable_objects": {
    "bindings": [{ "name": "STORE", "class_name": "WakppuStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WakppuStore"] }],
  // IP별 분당 요청 제한
  "ratelimits": [
    { "name": "RL_POST", "namespace_id": "4801", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_GET", "namespace_id": "4802", "simple": { "limit": 120, "period": 60 } }
  ],
  // OPENAI_API_KEY 는 여기 적지 말고 Cloudflare 대시보드의 비밀 변수(Secret)로 넣는다
  "vars": {
    "DAILY_LIMIT": "100"
    // 한 사람 하루 한도가 필요하면 "PER_IP_DAILY": "10" 처럼 넣는다 (없으면 제한 없음)
  },
  "observability": { "enabled": true }
}
