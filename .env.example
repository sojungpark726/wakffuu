# .env 로 복사해서 키를 넣으세요. (.env 는 git 에 올라가지 않습니다)
# 로컬 개발(npm run dev)용입니다. Cloudflare 배포판은 대시보드의 Variables and Secrets 에 넣습니다.

# 왁뿌볼 만들기 (gpt-image-1-mini 이미지 편집). 없으면 새 왁뿌볼을 만들 수 없음
OPENAI_API_KEY=

# 하루 한정 왁뿌볼 수 (한국 시간 0시에 초기화)
DAILY_LIMIT=100

# 한 사람(IP)이 하루에 만들 수 있는 수. 비워 두면 한 사람 제한 없음 (전체 한정만)
PER_IP_DAILY=
